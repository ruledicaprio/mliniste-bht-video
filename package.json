{
  "name": "mliniste-bht-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BH Telecom Mliniste video: source footage plus the deterministic HTML->PNG->MP4 renderers for the M-15 intro and the closing outro.",
  "license": "UNLICENSED",
  "scripts": {
    "preview:intro": "node animation/intro/server.mjs",
    "preview:outro": "node animation/outro/server.mjs",
    "render:intro": "node animation/intro/render.mjs",
    "render:outro": "node animation/outro/render.mjs",
    "frames:intro": "node animation/intro/render.mjs --no-video",
    "frames:outro": "node animation/outro/render.mjs --no-video",
    "plates:intro": "node animation/intro/extract-plates.mjs",
    "plates:outro": "node animation/outro/extract-plates.mjs",
    "body": "node animation/body/build.mjs",
    "assemble": "node animation/assemble.mjs",
    "film": "npm run plates:intro && npm run plates:outro && npm run render:intro && npm run render:outro && npm run body && npm run assemble",
    "route": "node animation/shared/extract-route.mjs",
    "test": "node --test \"animation/shared/test/*.test.mjs\" \"animation/*/test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "puppeteer-core": "^25.8.0"
  }
}
